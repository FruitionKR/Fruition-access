# access-svc 로컬 실행용 환경변수 예시.
#
# 이 파일을 `.env`로 복사한 뒤 값을 채웁니다 — `./gradlew bootRun`이 `$projectDir/.env`를 읽습니다
# (다른 위치는 `SERVICE_ENV_FILE=/절대/경로/.env`). `.env`는 커밋하지 않습니다.
#
# 기본값이 없어서 빠지면 기동이 실패하는 키만 "필수"로 적었습니다. 나머지 키와 기본값은
# src/main/resources/application*.properties를 보세요.
#
# 비밀값은 반드시 직접 생성하세요. 아래 자리표시자를 그대로 쓰면 운영 profile에서는
# ProductionSettings가 기동을 막습니다(INSECURE-NOT-FOR-PRODUCTION 표식).

# --- 필수: 없으면 기동 실패 ---

# JWT 서명 키(HS256). raw UTF-8 32바이트 이상이어야 합니다.
#   openssl rand -base64 48
JWT_SECRET=jwt-secret-INSECURE-NOT-FOR-PRODUCTION-local

# 서비스 간 내부 호출 토큰. 사용자 인증과 분리된 비밀값입니다.
#   openssl rand -hex 32
INTERNAL_CALLBACK_TOKEN=callback-token-INSECURE-NOT-FOR-PRODUCTION

# MFA secret 암호화 키. base64로 인코딩한 32바이트여야 합니다.
#   openssl rand -base64 32
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- 선택: 로컬 기본값으로 동작하지만 자주 바꾸는 키 ---

# access 전용 DB. 로컬 postgres에 access_db와 access_runtime 계정이 있어야 합니다.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# ACCESS_DB_NAME=access_db
# ACCESS_DB_RUNTIME_USER=access_runtime
# ACCESS_DB_RUNTIME_PASSWORD=access_runtime_dev_password
# ACCESS_DB_MIGRATION_USER=access_migration
# ACCESS_DB_MIGRATION_PASSWORD=access_migration_dev_password

# Redis. rate limit과 OAuth 교환 코드 store로 씁니다.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 이메일 인증번호. spring.mail.host가 없으면 로그 stub으로 동작합니다.
# AUTH_EMAIL_DEV_FIXED_CODE=9700

# OAuth client. 소셜 로그인을 실제로 쓸 때만 채웁니다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
